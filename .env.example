ANTHROPIC_API_KEY=
PORT=3000

# Required. Clients must send this value in the `x-api-key` header on
# POST /evaluate. Generate a fresh random value per environment - don't
# reuse across dev/prod.
API_AUTH_TOKEN=

# Optional override, defaults to claude-opus-5. Use claude-sonnet-5 or
# claude-haiku-4-5 for faster/cheaper responses during the hackathon demo.
CLAUDE_MODEL=claude-opus-5
